{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gc-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=GestionCelulares;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Key": "CAMBIA-ESTA-CLAVE-POR-UNA-LARGA-Y-SECRETA-DE-AL-MENOS-32-CHARS",
    "Issuer": "GestionCelulares",
    "Audience": "GestionCelulares",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Mora": {
    "Habilitado": true,
    "HoraDiaria": "01:00"
  }
}
